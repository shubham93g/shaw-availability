<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shaw IMAX Availability</title>
  <style>
    body { font-family: system-ui, sans-serif; font-size: 0.9rem; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
    .table-scroll { overflow-x: auto; margin-bottom: 1.5rem; }
    table { border-collapse: collapse; width: 100%; min-width: 700px; }
    th, td { border: 1px solid #ddd; padding: 0.4rem 0.6rem; text-align: left; }
    th { background: #f4f4f4; }
    tbody tr:hover { background: #f9fafb; }
    td.cell-time { text-align: right; font-variant-numeric: tabular-nums; }
    td.cell-availability {
      /* Caps the column itself, not just the inner content: without this,
         table-layout:auto distributes leftover table width proportionally
         to each column's preferred width, and .availability-inner's own
         min-width (needed to stop the pill wrapping) made this column's
         preferred width far larger than Movie/Venue/Time/Seats/Status's
         short natural content — so it got a hugely disproportionate share
         of the extra space. Capping it here lets that space go to columns
         that actually benefit from it, like Best Seats. Matches
         .availability-inner's own min-width below (kept in sync) rather
         than a rounder, looser number, so the column is sized to what the
         pill+value actually need and nothing more.  */
      max-width: 7.3rem;
    }
    td.cell-best-seats {
      /* Best Seats can hold a long, variable-length list of seat ranges —
         the column most worth prioritizing for extra table width. */
      width: 30%;
    }
    td.cell-book { text-align: center; padding: 0.3rem; }
    td.cell-book a {
      display: inline-block;
      padding: 0.3rem 0.9rem;
      background: #2563eb;
      color: #fff;
      font-weight: 600;
      border-radius: 4px;
      text-decoration: none;
    }
    td.cell-book a:hover { background: #1d4ed8; }
    .availability-inner {
      /* This flex layout lives on an inner <div>, never directly on the
         <td>: overriding a table-cell's own display to flex pulls it out
         of normal table-cell layout, so it stops stretching to the row's
         full height (rows are often much taller than one line because of
         the Best Seats column) — the background tint and cell border then
         only cover the short flex box instead of the whole cell. */
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: nowrap;
      /* Each table (day sections, "Top Most Available") auto-sizes its own
         columns from its own content, so the same column can end up
         narrower in one table than another; without a floor here, a
         table that happens to auto-size this column too tight would wrap
         the pill onto its own line — a real bug, not just a style choice,
         since it made the pill's position inconsistent between tables.
         Sized to the value+gap+pill's actual measured width (~112px) plus
         a few px of slack, not a round/generous guess — a looser min-width
         here directly inflates the column's final rendered width (see
         td.cell-availability's max-width comment above). */
      min-width: 7.3rem;
    }
    .availability-value {
      display: inline-block;
      min-width: 5ch;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .trend-toggle { display: inline-block; }
    .trend-toggle summary {
      cursor: pointer;
      list-style: none;
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 600;
      color: #2563eb;
      padding: 0.25rem 0.7rem;
      border: 1px solid #bfdbfe;
      border-radius: 999px;
      background: #eff6ff;
      white-space: nowrap;
    }
    .trend-toggle summary:hover { background: #dbeafe; }
    .trend-toggle summary::-webkit-details-marker { display: none; }
    .trend-popup {
      /* Moved to a direct child of <body> and placed by JS (see the
         trend-toggle script below) when opened, with position: absolute
         relative to the document — a table-scroll ancestor with
         overflow-x: auto implicitly clips overflow-y too (per the CSS
         overflow spec), so a popup this size can't be positioned relative
         to its row without being cut off for rows near a section's bottom.
         Positioned once at open time and closed on any scroll (see the
         trend-toggle script) rather than tracked continuously — simpler
         than reconciling page scroll against a nested container's own
         scroll (e.g. .table-scroll's horizontal pan on narrow viewports). */
      position: absolute;
      z-index: 1000;
      padding: 0.4rem 0.5rem;
      background: #fff;
      border: 1px solid #ddd;
      border-radius: 4px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      /* The whole popup, not just the chart, refuses to start a native
         scroll/pan gesture: a touch that starts a pixel outside the SVG
         (header text, padding — easy to hit on a small popup on a small
         phone) would otherwise still hand off to the browser's scroll
         gesture before the drag ever reaches the chart. The popup has no
         internal scroll of its own once open, so this has no downside. */
      touch-action: none;
    }
    .trend-popup-header {
      font-size: 0.75rem;
      font-weight: 600;
      color: #374151;
      margin-bottom: 0.25rem;
      white-space: nowrap;
    }
    .trend-hover-readout {
      font-size: 0.75rem;
      color: #6b7280;
      margin-bottom: 0.35rem;
      min-height: 1.1em;
    }
    .trend-hover-readout .trend-hover-pct,
    .trend-hover-readout .trend-hover-time { display: none; }
    .trend-hover-readout.is-active .trend-hover-placeholder { display: none; }
    .trend-hover-readout.is-active .trend-hover-pct,
    .trend-hover-readout.is-active .trend-hover-time { display: inline; }
    .trend-hover-pct { font-weight: 600; color: #111827; }
    .trend-hover-time { color: #6b7280; margin-left: 0.35rem; }
    .trend-sparkline { display: block; }
    .trend-crosshair { stroke: #9ca3af; stroke-width: 1; pointer-events: none; opacity: 0; }
    .trend-hover-dot { fill: #2e7d32; stroke: #fff; stroke-width: 1.5; pointer-events: none; opacity: 0; }
    tbody tr.row-clicked { background: #fff7e6; }
    tbody tr.row-clicked:hover { background: #fdecc8; }
    tbody tr.row-clicked td:first-child {
      box-shadow: inset 4px 0 0 0 #b45309;
    }
    h2 { margin-top: 2rem; }
    #venue-filter { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; margin: 1rem 0; }
    #venue-filter label { display: inline-flex; align-items: center; gap: 0.35rem; }
    #date-jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0; }
    #date-jump a, .back-to-top {
      display: inline-block;
      padding: 0.25rem 0.7rem;
      border: 1px solid #ddd;
      border-radius: 999px;
      background: #fafafa;
      color: inherit;
      text-decoration: none;
      font-size: 0.85rem;
    }
    #date-jump a:hover, .back-to-top:hover { background: #f4f4f4; }
    section[data-day-section] { scroll-margin-top: 0.5rem; }
    tr[data-venue].venue-hidden { display: none; }
    .stats-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1rem 0; }
    .stat-tile { border: 1px solid #ddd; border-radius: 6px; padding: 0.6rem 1rem; min-width: 160px; background: #fafafa; }
    .stat-label { font-size: 0.75rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.03em; }
    .stat-value { font-size: 0.95rem; margin-top: 0.15rem; }
    .stat-caption { font-size: 0.78rem; color: #6b7280; margin-top: 0.2rem; }
    .stat-tile-warning { border-color: #b45309; background: #fff7e6; }
    .stat-tile-warning .stat-value { color: #b45309; }
    h1 { margin: 0 0 0.3rem; }
    .report-metadata { color: #6b7280; font-size: 0.85rem; margin: 0 0 0.2rem; }
    .report-metadata a, .report-metadata a:visited { color: #2563eb; }
  </style>
</head>
<body>
  {% macro cell(content, css_class="", style="") %}<td{% if css_class %} class="{{ css_class }}"{% endif %}{% if style %} style="{{ style }}"{% endif %}>{{ content }}</td>{% endmacro %}

  {% macro book_cell(url) %}<td class="cell-book"><a href="{{ url }}" target="_blank" rel="noopener noreferrer">Book</a></td>{% endmacro %}

  {% macro show_table_head(show_date=True) %}
  <thead>
    <tr>
      {% if show_date %}<th>Date</th>{% endif %}<th>Movie</th><th>Venue</th><th>Time</th><th>Availability</th>
      <th>Seats</th><th>Status</th><th>Best Seats</th><th>Book</th>
    </tr>
  </thead>
  {% endmacro %}

  {% macro show_row(show) %}
  <tr data-performance-id="{{ show.performance_id }}" data-venue="{{ show.venue_name }}" data-availability="{{ show.availability_pct }}" data-date-label="{{ short_date(show.display_date) }}">
    {{ cell(show.movie_title) }}
    {{ cell(show.venue_name) }}
    {{ cell(show.display_time, "cell-time") }}
    {% set availability_cell %}<div class="availability-inner"><span class="availability-value">{{ "%.1f%%"|format(show.availability_pct) }}</span>{{ trend_sparkline(report.history_by_performance_id.get(show.performance_id), show.movie_title, show.venue_name, show.display_time) }}</div>{% endset %}
    {{ cell(availability_cell, "cell-availability", availability_style(show.availability_pct)) }}
    {{ cell(show.available ~ "/" ~ show.total_seats) }}
    {{ cell(status_label(show.api_seating_status)) }}
    {{ cell(show.best_seats_available|join(", ") if show.best_seats_available else "-", "cell-best-seats") }}
    {{ book_cell(booking_url(show.performance_id)) }}
  </tr>
  {% endmacro %}

  <h1>Shaw IMAX Availability Report</h1>
  <p class="report-metadata">Updated every 30 minutes, 7:00am&ndash;11:00pm SGT; every 2 hours overnight.</p>
  <p class="report-metadata"><a href="mailto:ring-mohair.0k@icloud.com">Contact</a> <span id="share-separator" style="display:none;">|</span> <a href="#" id="share-page" style="display:none;">Share</a></p>
  <p class="report-metadata">Generated: {{ generated_at_display }} (<span id="generated-ago" data-generated-at-ms="{{ generated_at_epoch_ms }}">just now</span>)</p>

  {% if report.venues %}
  <div id="venue-filter">
    {% for venue in report.venues %}
    <label><input type="checkbox" class="venue-checkbox" value="{{ venue }}" checked> {{ venue }}</label>
    {% endfor %}
  </div>
  {% endif %}

  {% if report.day_sections %}
  <nav id="date-jump">
    {% for section in report.day_sections %}
    <a href="#day-{{ section.date }}">{{ short_date(section.date) }}</a>
    {% endfor %}
  </nav>
  {% endif %}

  <section data-most-available data-most-available-count="{{ most_available_count }}">
    <h2>Top Most Available</h2>
    <div class="table-scroll">
      <table>
        {{ show_table_head() }}
        <tbody></tbody>
      </table>
    </div>
  </section>

  {% if report.day_sections %}
    {% for section in report.day_sections %}
      <section data-day-section id="day-{{ section.date }}">
        <h2>{{ short_date(section.date) }}</h2>
        <p><span class="avg-pct">{{ "%.1f"|format(section.avg_availability_pct) }}</span>% average availability &middot; <span class="show-count">{{ section.show_count }}</span> shows &middot; <a class="back-to-top" href="#">Back to Top</a></p>
        <div class="table-scroll">
          <table>
            {{ show_table_head(show_date=False) }}
            <tbody>
              {% for show in section.shows %}{{ show_row(show) }}{% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    {% endfor %}
  {% else %}
    <p>No shows scanned.</p>
  {% endif %}

  <div class="stats-row">
    <div class="stat-tile">
      <div class="stat-label">Scan window</div>
      <div class="stat-value">
        {% if report.dates_scanned %}{{ short_date(report.dates_scanned[0]) }} &ndash; {{ short_date(report.dates_scanned[-1]) }}{% else %}n/a{% endif %}
      </div>
      <div class="stat-caption">{{ report.dates_scanned|length }} day(s) &middot; {{ report.stop_reason }}</div>
    </div>
    <div class="stat-tile">
      <div class="stat-label">Showtimes collected</div>
      <div class="stat-value">{{ report.total_shows }}</div>
    </div>
    {% if report.failed_calls %}
    <div class="stat-tile stat-tile-warning">
      <div class="stat-label">Failed API calls</div>
      <div class="stat-value">&#9888; {{ report.failed_calls|length }}</div>
    </div>
    {% endif %}
  </div>

  {% if report.failed_calls %}
  <h2>Failed calls ({{ report.failed_calls|length }})</h2>
  <ul>
    {% for f in report.failed_calls %}
    <li>[{{ f.kind }}] {{ f.identifier }}: {{ f.error }}</li>
    {% endfor %}
  </ul>
  {% endif %}

  <script>
    var GENERATED_AGO_REFRESH_MS = 60000;

    function relativeAgoLabel(sinceMs) {
      var seconds = Math.max(0, Math.floor(sinceMs / 1000));
      if (seconds < 60) return "just now";
      var minutes = Math.floor(seconds / 60);
      if (minutes < 60) return minutes + " min" + (minutes !== 1 ? "s" : "") + " ago";
      var hours = Math.floor(minutes / 60);
      if (hours < 24) return hours + " hour" + (hours !== 1 ? "s" : "") + " ago";
      var days = Math.floor(hours / 24);
      return days + " day" + (days !== 1 ? "s" : "") + " ago";
    }

    function updateGeneratedAgo() {
      var el = document.getElementById("generated-ago");
      if (!el) return;
      var generatedAtMs = Number(el.getAttribute("data-generated-at-ms"));
      el.textContent = relativeAgoLabel(Date.now() - generatedAtMs);
    }

    updateGeneratedAgo();
    setInterval(updateGeneratedAgo, GENERATED_AGO_REFRESH_MS);
  </script>

  <script>
    document.body.addEventListener("click", function (event) {
      var link = event.target.closest("td.cell-book a");
      if (!link) return;
      var row = link.closest("tr");
      var performanceId = row && row.getAttribute("data-performance-id");
      if (!performanceId) return;
      document
        .querySelectorAll('tr[data-performance-id="' + performanceId + '"]')
        .forEach(function (matchedRow) {
          matchedRow.classList.add("row-clicked");
        });
    });
  </script>

  <script>
    // Popups are detached to a direct child of <body> while open (see the
    // .trend-popup CSS comment for why) and moved back into their owning
    // <details> on close, so a row's markup is always complete again by the
    // time rebuildMostAvailable() might clone it. Positioning happens once,
    // synchronously, at open time (closeAllTrendPopups below closes rather
    // than re-tracks on scroll) — so there's no async gap where an
    // unpositioned popup could flash in the wrong place before a listener
    // catches up.
    function closeTrendPopup(details) {
      details.open = false;
      var popup = details._openPopup;
      if (popup) {
        hideTrendHover(popup);
        details.appendChild(popup);
        details._openPopup = null;
      }
    }

    function openTrendPopup(details) {
      document.querySelectorAll("details.trend-toggle[open]").forEach(function (other) {
        if (other !== details) closeTrendPopup(other);
      });

      var popup = details.querySelector(".trend-popup");
      var summary = details.querySelector("summary");
      if (!popup || !summary) return;

      details.open = true;

      var rect = summary.getBoundingClientRect();
      document.body.appendChild(popup);
      details._openPopup = popup;

      var margin = 8;
      var left = rect.left + window.scrollX + rect.width / 2 - popup.offsetWidth / 2;
      left = Math.max(
        window.scrollX + margin,
        Math.min(left, window.scrollX + window.innerWidth - popup.offsetWidth - margin)
      );
      var top = rect.bottom + window.scrollY + 4;
      if (rect.bottom + popup.offsetHeight + 4 > window.innerHeight - margin) {
        top = rect.top + window.scrollY - popup.offsetHeight - 4;
        // On a viewport short enough that even flipping above the anchor
        // doesn't fully fit, don't let it go further than the top margin —
        // better to overlap the anchor slightly than render off-screen
        // above the current scroll position with no visible way to it.
        top = Math.max(window.scrollY + margin, top);
      }
      popup.style.left = left + "px";
      popup.style.top = top + "px";
    }

    document.body.addEventListener("click", function (event) {
      var summary = event.target.closest(".trend-toggle > summary");
      if (summary) {
        // Handle the toggle ourselves (open/close, positioning) rather than
        // letting <details> do it natively: the native path fires an async
        // "toggle" event, leaving a window where the browser can paint the
        // just-opened popup at its unset default position before a listener
        // repositions it — visible as a flash in the wrong place.
        event.preventDefault();
        var details = summary.parentElement;
        if (details.open) {
          closeTrendPopup(details);
        } else {
          openTrendPopup(details);
        }
        return;
      }

      document.querySelectorAll("details.trend-toggle[open]").forEach(function (details) {
        var popup = details._openPopup;
        var insideTrigger = details.contains(event.target);
        var insidePopup = popup && popup.contains(event.target);
        if (!insideTrigger && !insidePopup) closeTrendPopup(details);
      });
    });

    function closeAllTrendPopups() {
      document.querySelectorAll("details.trend-toggle[open]").forEach(closeTrendPopup);
    }

    // Closing on any scroll — page scroll or a nested container's own
    // scroll, like .table-scroll's horizontal pan on narrow viewports —
    // keeps behavior consistent regardless of scroll source, rather than
    // tracking one axis and closing on the other. capture: true is what
    // catches .table-scroll's scroll here: it doesn't bubble, but a
    // capturing listener on window still sees it on the way down to target.
    window.addEventListener("scroll", closeAllTrendPopups, { capture: true, passive: true });

    // Repositioning an open popup on resize would need the same math as
    // open-time placement; closing it instead (like many native popovers do
    // on a layout change) is simpler and avoids a stale/misplaced popup.
    window.addEventListener("resize", closeAllTrendPopups);
  </script>

  <script>
    // Crosshair/readout hover layer for trend sparklines. The crosshair
    // line and hover dot are SVG children created lazily on first
    // interaction (looked up via querySelector rather than cached on a JS
    // property, so a chart cloned via cloneNode() — see
    // rebuildMostAvailable() below — creates/reuses its own overlay
    // instead of sharing state with the row it was cloned from); the value
    // readout is plain text in normal document flow, already part of the
    // server-rendered popup markup (see _trend_sparkline_svg in
    // report.py), so it can never render off-screen the way an
    // absolutely-positioned tooltip could on a narrow viewport. Pointer
    // Events unify mouse hover and touch-drag scrubbing into one code
    // path; CSS touch-action: none (see .trend-popup) is what stops the
    // page from scrolling during a touch drag, so no preventDefault()/
    // passive listener handling is needed here.
    var SVG_NS = "http://www.w3.org/2000/svg";

    function trendHoverData(svg) {
      if (svg._trendHoverData === undefined) {
        try {
          svg._trendHoverData = JSON.parse(svg.getAttribute("data-points") || "null");
        } catch (e) {
          svg._trendHoverData = null;
        }
      }
      return svg._trendHoverData;
    }

    function trendHoverOverlay(svg) {
      var popup = svg.closest(".trend-popup");
      if (!popup) return null;

      var crosshair = svg.querySelector(".trend-crosshair");
      if (!crosshair) {
        crosshair = document.createElementNS(SVG_NS, "line");
        crosshair.setAttribute("class", "trend-crosshair");
        svg.appendChild(crosshair);
      }

      var dot = svg.querySelector(".trend-hover-dot");
      if (!dot) {
        dot = document.createElementNS(SVG_NS, "circle");
        dot.setAttribute("class", "trend-hover-dot");
        dot.setAttribute("r", "4");
        svg.appendChild(dot);
      }

      // The readout line is already part of the server-rendered popup
      // markup (a sibling of the header, before the <svg>) — nothing to
      // create here, it's in normal document flow so it can never render
      // off-screen the way an absolutely-positioned tooltip could.
      var readout = popup.querySelector(".trend-hover-readout");

      return {
        crosshair: crosshair,
        dot: dot,
        readout: readout,
        pctEl: readout.querySelector(".trend-hover-pct"),
        timeEl: readout.querySelector(".trend-hover-time")
      };
    }

    function hideTrendHover(popupOrSvg) {
      var svg = popupOrSvg.classList && popupOrSvg.classList.contains("trend-sparkline")
        ? popupOrSvg
        : popupOrSvg.querySelector(".trend-sparkline");
      if (!svg) return;
      var crosshair = svg.querySelector(".trend-crosshair");
      var dot = svg.querySelector(".trend-hover-dot");
      var popup = svg.closest(".trend-popup");
      var readout = popup && popup.querySelector(".trend-hover-readout");
      if (crosshair) crosshair.style.opacity = "0";
      if (dot) dot.style.opacity = "0";
      if (readout) readout.classList.remove("is-active");
    }

    function nearestTrendPoint(points, x) {
      var nearest = points[0];
      var bestDistance = Math.abs(points[0].x - x);
      for (var i = 1; i < points.length; i++) {
        var distance = Math.abs(points[i].x - x);
        if (distance < bestDistance) {
          bestDistance = distance;
          nearest = points[i];
        }
      }
      return nearest;
    }

    function updateTrendHover(svg, clientX) {
      var data = trendHoverData(svg);
      if (!data || !data.points || !data.points.length) return;

      var rect = svg.getBoundingClientRect();
      if (!rect.width) return;
      // Scale: CSS pixels per SVG viewBox unit, needed to convert the
      // pointer's clientX into the same coordinate space as the data
      // points' x values (svg viewBox units) for the nearest-point lookup
      // below.
      var viewBox = svg.viewBox.baseVal;
      var scale = rect.width / viewBox.width;
      var svgX = (clientX - rect.left) / scale;

      var point = nearestTrendPoint(data.points, svgX);
      var overlay = trendHoverOverlay(svg);
      if (!overlay) return;

      overlay.crosshair.setAttribute("x1", point.x);
      overlay.crosshair.setAttribute("x2", point.x);
      overlay.crosshair.setAttribute("y1", data.top);
      overlay.crosshair.setAttribute("y2", data.bottom);
      overlay.crosshair.style.opacity = "1";

      overlay.dot.setAttribute("cx", point.x);
      overlay.dot.setAttribute("cy", point.y);
      overlay.dot.style.opacity = "1";

      overlay.pctEl.textContent = point.pct.toFixed(1) + "%";
      overlay.timeEl.textContent = point.t;
      overlay.readout.classList.add("is-active");
    }

    document.body.addEventListener("pointerdown", function (event) {
      var svg = event.target.closest(".trend-sparkline");
      if (!svg) return;
      if (event.pointerType !== "mouse") svg.setPointerCapture(event.pointerId);
      updateTrendHover(svg, event.clientX);
    });

    document.body.addEventListener("pointermove", function (event) {
      var svg = event.target.closest(".trend-sparkline");
      if (!svg) return;
      updateTrendHover(svg, event.clientX);
    });

    document.body.addEventListener("pointerup", function (event) {
      var svg = event.target.closest(".trend-sparkline");
      if (svg) hideTrendHover(svg);
    });
    document.body.addEventListener("pointercancel", function (event) {
      var svg = event.target.closest(".trend-sparkline");
      if (svg) hideTrendHover(svg);
    });

    // capture: true because pointerleave doesn't bubble — same reasoning
    // as the window "scroll" listener above.
    document.body.addEventListener("pointerleave", function (event) {
      var svg = event.target.closest(".trend-sparkline");
      if (svg) hideTrendHover(svg);
    }, true);
  </script>

  <script>
    var VENUE_FILTER_KEY = "shaw-venue-filter";
    var checkboxes = Array.prototype.slice.call(document.querySelectorAll(".venue-checkbox"));

    function selectedVenues() {
      return checkboxes.filter(function (cb) { return cb.checked; }).map(function (cb) { return cb.value; });
    }

    function rebuildMostAvailable() {
      var section = document.querySelector("[data-most-available]");
      if (!section) return;
      var tbody = section.querySelector("tbody");
      if (!tbody) return;

      // Close any open trend popup first: closeTrendPopup() moves the popup
      // back inside its <details> before cloneNode below runs, so a row's
      // clone always carries its full popup markup rather than an empty
      // <details> whose popup is sitting detached under <body>.
      document.querySelectorAll("details.trend-toggle[open]").forEach(closeTrendPopup);

      var n = parseInt(section.getAttribute("data-most-available-count"), 10);
      var candidates = Array.prototype.slice
        .call(document.querySelectorAll("[data-day-section] tr[data-venue]"))
        .filter(function (row) { return !row.classList.contains("venue-hidden"); })
        .sort(function (a, b) {
          return parseFloat(b.getAttribute("data-availability")) - parseFloat(a.getAttribute("data-availability"));
        })
        .slice(0, n);

      tbody.innerHTML = "";
      candidates.forEach(function (row) {
        var clone = row.cloneNode(true);
        clone.classList.remove("venue-hidden");
        var dateCell = document.createElement("td");
        dateCell.textContent = row.getAttribute("data-date-label");
        clone.insertBefore(dateCell, clone.firstChild);
        tbody.appendChild(clone);
      });
    }

    function applyFilter() {
      var selected = selectedVenues();
      var selectedSet = {};
      selected.forEach(function (v) { selectedSet[v] = true; });

      document.querySelectorAll("tr[data-venue]").forEach(function (row) {
        var visible = !!selectedSet[row.getAttribute("data-venue")];
        row.classList.toggle("venue-hidden", !visible);
      });

      document.querySelectorAll("[data-day-section]").forEach(function (section) {
        var visibleRows = Array.prototype.slice
          .call(section.querySelectorAll("tr[data-venue]"))
          .filter(function (row) { return !row.classList.contains("venue-hidden"); });
        var countEl = section.querySelector(".show-count");
        var avgEl = section.querySelector(".avg-pct");
        if (countEl) countEl.textContent = visibleRows.length;
        if (avgEl) {
          if (visibleRows.length === 0) {
            avgEl.textContent = "n/a";
          } else {
            var total = visibleRows.reduce(function (sum, row) {
              return sum + parseFloat(row.getAttribute("data-availability"));
            }, 0);
            avgEl.textContent = (total / visibleRows.length).toFixed(1);
          }
        }
      });

      rebuildMostAvailable();
    }

    if (checkboxes.length) {
      try {
        var stored = JSON.parse(localStorage.getItem(VENUE_FILTER_KEY) || "null");
        if (Array.isArray(stored)) {
          var knownVenues = checkboxes.map(function (cb) { return cb.value; });
          var storedValid = stored.filter(function (v) { return knownVenues.indexOf(v) !== -1; });
          if (storedValid.length) {
            var storedSet = {};
            storedValid.forEach(function (v) { storedSet[v] = true; });
            checkboxes.forEach(function (cb) { cb.checked = !!storedSet[cb.value]; });
          }
        }
      } catch (e) {
        // Ignore malformed localStorage content and keep the default all-checked state.
      }

      checkboxes.forEach(function (cb) {
        cb.addEventListener("change", function () {
          localStorage.setItem(VENUE_FILTER_KEY, JSON.stringify(selectedVenues()));
          applyFilter();
        });
      });

      applyFilter();
    }
  </script>

  <script>
    var shareLink = document.getElementById("share-page");
    var shareSeparator = document.getElementById("share-separator");
    if (shareLink && navigator.share) {
      shareLink.style.display = "";
      if (shareSeparator) shareSeparator.style.display = "";
      shareLink.addEventListener("click", function (event) {
        event.preventDefault();
        navigator.share({ title: document.title, url: location.origin });
      });
    }
  </script>
</body>
</html>
