var GENERATED_AGO_REFRESH_MS = 60000;

function relativeAgoLabel(sinceMs) {
  var seconds = Math.max(0, Math.floor(sinceMs / 1000));
  if (seconds < 60) return "just now";
  var minutes = Math.floor(seconds / 60);
  if (minutes < 60) return minutes + " min" + (minutes !== 1 ? "s" : "") + " ago";
  var hours = Math.floor(minutes / 60);
  if (hours < 24) return hours + " hour" + (hours !== 1 ? "s" : "") + " ago";
  var days = Math.floor(hours / 24);
  return days + " day" + (days !== 1 ? "s" : "") + " ago";
}

function updateGeneratedAgo() {
  var el = document.getElementById("generated-ago");
  if (!el) return;
  var generatedAtMs = Number(el.getAttribute("data-generated-at-ms"));
  el.textContent = relativeAgoLabel(Date.now() - generatedAtMs);
}

updateGeneratedAgo();
setInterval(updateGeneratedAgo, GENERATED_AGO_REFRESH_MS);
