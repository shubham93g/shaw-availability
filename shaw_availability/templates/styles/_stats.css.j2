.stats-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1rem 0; }
.stat-tile { border: 1px solid #ddd; border-radius: 6px; padding: 0.6rem 1rem; min-width: 160px; background: #fafafa; }
.stat-label { font-size: 0.75rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.03em; }
.stat-value { font-size: 0.95rem; margin-top: 0.15rem; }
.stat-caption { font-size: 0.78rem; color: #6b7280; margin-top: 0.2rem; }
.stat-tile-warning { border-color: #b45309; background: #fff7e6; }
.stat-tile-warning .stat-value { color: #b45309; }
